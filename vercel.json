{
  "buildCommand": "pnpm --filter bin-alzain-frontend build && pnpm --filter bin-alzain-backend build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/daily-rollup", "schedule": "0 21 * * *" }
  ]
}
